{
  "manifest_version": 3,
  "name": "webgd",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open webgd" },
  "permissions": ["tabs"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_about_blank": true },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
